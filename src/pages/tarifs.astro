---
import Base from '../layouts/Base.astro';
import Wave from '../components/Wave.astro';
import { loadGrilles, type GrilleContent } from '../lib/content';

const WA = 'https://wa.me/66806853817';

// Grilles chargées depuis Supabase (éditées via /admin). Repli : grilles 2026 embarquées.
const fromDb = await loadGrilles();

const FALLBACK: GrilleContent[] = [
  { nom: 'Caribian 2+2', type: 'voiture', caution: 10000, prix: { '1-6': { PIK: 1500, HAUTE: 1200, MOYENNE: 1000, BASSE: 800 }, '7-13': { PIK: 1400, HAUTE: 1100, MOYENNE: 900, BASSE: 700 }, '14-20': { PIK: 1100, HAUTE: 900, MOYENNE: 700, BASSE: 600 }, '21-29': { PIK: null, HAUTE: 800, MOYENNE: 600, BASSE: 500 }, mois: { PIK: null, HAUTE: 18000, MOYENNE: 16000, BASSE: 14000 } } },
  { nom: 'Caribian + (5 places)', type: 'voiture', caution: 10000, prix: { '1-6': { PIK: 1600, HAUTE: 1300, MOYENNE: 1100, BASSE: 900 }, '7-13': { PIK: 1500, HAUTE: 1200, MOYENNE: 1000, BASSE: 800 }, '14-20': { PIK: 1300, HAUTE: 1000, MOYENNE: 800, BASSE: 700 }, '21-29': { PIK: null, HAUTE: 900, MOYENNE: 700, BASSE: 600 }, mois: { PIK: null, HAUTE: 19000, MOYENNE: 17000, BASSE: 15000 } } },
  { nom: 'Ford Ecosport', type: 'voiture', caution: 10000, prix: { '1-6': { PIK: 1700, HAUTE: 1400, MOYENNE: 1200, BASSE: 1000 }, '7-13': { PIK: 1600, HAUTE: 1300, MOYENNE: 1100, BASSE: 900 }, '14-20': { PIK: 1400, HAUTE: 1100, MOYENNE: 900, BASSE: 800 }, '21-29': { PIK: null, HAUTE: 1000, MOYENNE: 800, BASSE: 700 }, mois: { PIK: null, HAUTE: 20000, MOYENNE: 18000, BASSE: 16000 } } },
  { nom: 'Honda CRV', type: 'voiture', caution: 10000, prix: { '1-6': { PIK: 1600, HAUTE: 1300, MOYENNE: 1100, BASSE: 900 }, '7-13': { PIK: 1500, HAUTE: 1200, MOYENNE: 1000, BASSE: 800 }, '14-20': { PIK: 1300, HAUTE: 1000, MOYENNE: 800, BASSE: 700 }, '21-29': { PIK: null, HAUTE: 900, MOYENNE: 700, BASSE: 600 }, mois: { PIK: null, HAUTE: 19000, MOYENNE: 17000, BASSE: 15000 } } },
  { nom: 'Ford Ranger', type: 'voiture', caution: 10000, prix: { '1-6': { PIK: 2000, HAUTE: 2000, MOYENNE: 2000, BASSE: 2000 }, '7-13': { PIK: 1800, HAUTE: 1800, MOYENNE: 1800, BASSE: 1800 }, '14-20': { PIK: 1600, HAUTE: 1600, MOYENNE: 1600, BASSE: 1600 }, '21-29': { PIK: 1400, HAUTE: 1400, MOYENNE: 1400, BASSE: 1400 }, mois: { PIK: 30000, HAUTE: 30000, MOYENNE: 30000, BASSE: 30000 } } },
  { nom: 'Honda ADV 350', type: 'scooter', caution: 10000, prix: { '1-6': { PIK: 1000, HAUTE: 900, BASSE: 600 }, '7-13': { PIK: 950, HAUTE: 850, BASSE: 500 }, '14-20': { PIK: 900, HAUTE: 800, BASSE: 400 }, '21-29': { PIK: null, HAUTE: 750, BASSE: 350 }, mois: { PIK: null, HAUTE: 15000, BASSE: 10000 } } },
  { nom: 'Honda Forza 350', type: 'scooter', caution: 10000, prix: { '1-6': { PIK: 1000, HAUTE: 900, BASSE: 600 }, '7-13': { PIK: 950, HAUTE: 850, BASSE: 500 }, '14-20': { PIK: 900, HAUTE: 800, BASSE: 400 }, '21-29': { PIK: null, HAUTE: 750, BASSE: 350 }, mois: { PIK: null, HAUTE: 15000, BASSE: 10000 } } },
  { nom: 'Yamaha XMAX 300', type: 'scooter', caution: 10000, prix: { '1-6': { PIK: 800, HAUTE: 700, BASSE: 500 }, '7-13': { PIK: 750, HAUTE: 650, BASSE: 450 }, '14-20': { PIK: 700, HAUTE: 600, BASSE: 400 }, '21-29': { PIK: null, HAUTE: 550, BASSE: 350 }, mois: { PIK: null, HAUTE: 12000, BASSE: 8000 } } },
  { nom: 'Honda ADV 160', type: 'scooter', caution: 5000, prix: { '1-6': { PIK: 550, HAUTE: 450, BASSE: 350 }, '7-13': { PIK: 500, HAUTE: 400, BASSE: 300 }, '14-20': { PIK: 450, HAUTE: 350, BASSE: 250 }, '21-29': { PIK: null, HAUTE: 300, BASSE: 220 }, mois: { PIK: null, HAUTE: 7000, BASSE: 5000 } } },
  { nom: 'Honda Click 160', type: 'scooter', caution: 5000, prix: { '1-6': { PIK: 450, HAUTE: 350, BASSE: 300 }, '7-13': { PIK: 400, HAUTE: 300, BASSE: 250 }, '14-20': { PIK: 350, HAUTE: 250, BASSE: 200 }, '21-29': { PIK: null, HAUTE: 200, BASSE: 180 }, mois: { PIK: null, HAUTE: 5000, BASSE: 4000 } } },
  { nom: 'Honda Click 125', type: 'scooter', caution: 3000, prix: { '1-6': { PIK: 350, HAUTE: 250, BASSE: 200 }, '7-13': { PIK: 280, HAUTE: 200, BASSE: 180 }, '14-20': { PIK: 230, HAUTE: 180, BASSE: 150 }, '21-29': { PIK: null, HAUTE: 150, BASSE: 130 }, mois: { PIK: null, HAUTE: 4000, BASSE: 3000 } } },
];

const grilles = fromDb ?? FALLBACK;
const voitures = grilles.filter((g) => g.type === 'voiture');
const scooters = grilles.filter((g) => g.type === 'scooter');

const SAISONS_V = ['PIK', 'HAUTE', 'MOYENNE', 'BASSE'];
const SAISONS_S = ['PIK', 'HAUTE', 'BASSE'];
const DUREES: [string, string][] = [
  ['1-6', '1 à 6 jours'], ['7-13', '7 à 13 jours'], ['14-20', '14 à 20 jours'],
  ['21-29', '21 à 29 jours'], ['mois', '1 mois'],
];
const legendesVoitures = [
  { nom: 'PIK', periode: '21 déc → 7 janv' },
  { nom: 'HAUTE', periode: '8 janv → 31 mars · 16 juil → 31 août' },
  { nom: 'MOYENNE', periode: '1 avr → 15 mai · sept-nov · 1 → 20 déc' },
  { nom: 'BASSE', periode: '16 mai → 15 juil' },
];
const legendesScooters = [
  { nom: 'PIK', periode: '21 déc → 7 janv' },
  { nom: 'HAUTE', periode: '8 janv → 15 avr · 16 juil → 31 août' },
  { nom: 'BASSE', periode: '16 avr → 15 juil · sept-nov · 1 → 20 déc' },
];

const fmt = (n: number | null | undefined) =>
  n === null || n === undefined ? '—' : `${n.toLocaleString('fr-FR')} ฿`;
/** Vrai si la grille a le même prix sur toutes les saisons (ex. Ford Ranger). */
const tarifUnique = (g: GrilleContent) =>
  DUREES.every(([d]) => {
    const vals = SAISONS_V.map((s) => g.prix[d]?.[s]).filter((x) => x !== undefined);
    return vals.every((x) => x === vals[0]);
  });
---
<Base
  title="Tarifs — grilles complètes par saison | Caribian Rental Samui"
  description="Tous nos prix de location à Koh Samui, publics et sans astérisque : voitures et scooters, par saison et par durée. Caution et franchise annoncées d'avance."
  path="/tarifs/"
>
  <header class="page-head">
    <span class="kicker">Tarifs</span>
    <h1>Des prix sans astérisque</h1>
    <p>
      Toute la grille, en bahts, par saison et par durée. Ce que vous voyez ici est
      ce que vous payez — TVA et assurance incluses (franchise 20 000 ฿).
    </p>
  </header>
  <Wave fill="#fbf5ea" bg="#084c54" />

  <section>
    <div class="in" style="padding-top:44px">
      <span class="kicker rv">Voitures</span>
      <h2 class="rv" style="--d:.06s">Caribian, SUV &amp; pick-up</h2>
      <div class="legend rv" style="--d:.16s">
        {legendesVoitures.map((s) => <span><b>{s.nom}</b> {s.periode}</span>)}
      </div>

      {voitures.map((v, vi) => (
        <div class="bloc rv" style={`--d:${0.06 * (vi % 2)}s`}>
          <h3>{v.nom} <em>caution {v.caution.toLocaleString('fr-FR')} ฿</em></h3>
          <div class="twrap">
            {tarifUnique(v) ? (
              <table class="tarifs">
                <thead><tr><th>Durée</th><th>Tarif unique toutes saisons</th></tr></thead>
                <tbody>
                  {DUREES.map(([d, dl]) => (
                    <tr><td>{dl}</td><td class="hl">{fmt(v.prix[d]?.PIK)}</td></tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <table class="tarifs">
                <thead>
                  <tr><th>Durée</th>{SAISONS_V.map((s) => <th>{s}</th>)}</tr>
                </thead>
                <tbody>
                  {DUREES.map(([d, dl]) => (
                    <tr>
                      <td>{dl}</td>
                      {SAISONS_V.map((s, si) => (
                        <td class={si === 3 ? 'hl' : undefined}>{fmt(v.prix[d]?.[s])}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="deep">
    <Wave fill="#fbf5ea" flip />
    <div class="in">
      <span class="kicker rv">Scooters</span>
      <h2 class="rv" style="--d:.06s">Du Click 125 au maxi-scooter</h2>
      <div class="legend onDeep rv" style="--d:.12s">
        {legendesScooters.map((s) => <span><b>{s.nom}</b> {s.periode}</span>)}
      </div>

      <div class="scoot-grid">
        {scooters.map((s, si) => (
          <div class="bloc rv" style={`--d:${0.06 * (si % 2)}s`}>
            <h3>{s.nom} <em>caution {s.caution.toLocaleString('fr-FR')} ฿</em></h3>
            <div class="twrap">
              <table class="tarifs">
                <thead>
                  <tr><th>Durée</th>{SAISONS_S.map((x) => <th>{x}</th>)}</tr>
                </thead>
                <tbody>
                  {DUREES.map(([d, dl]) => (
                    <tr>
                      <td>{dl}</td>
                      {SAISONS_S.map((x, xi) => (
                        <td class={xi === 2 ? 'hl' : undefined}>{fmt(s.prix[d]?.[x])}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
      </div>
    </div>
    <Wave fill="#fbf5ea" bg="#084c54" />
  </section>

  <section>
    <div class="in essentials">
      <span class="kicker rv">L'essentiel</span>
      <h2 class="rv" style="--d:.06s">Ce qui est toujours vrai</h2>
      <div class="facts">
        <div class="fact rv"><b>Inclus</b>TVA et assurance gouvernementale (franchise 20 000 ฿).</div>
        <div class="fact rv" style="--d:.06s"><b>Acompte</b>1 000 ฿ à la réservation, le solde à la remise des clés.</div>
        <div class="fact rv" style="--d:.12s"><b>Annulation</b>Gratuite jusqu'à 7 jours avant le début de la location.</div>
        <div class="fact rv" style="--d:.18s"><b>Non inclus</b>Essence (plein rendu = plein reçu), livraison hors conditions.</div>
      </div>
      <div style="text-align:center; margin-top:36px">
        <a class="btn-sun rv" href="/reserver/">Vérifier une disponibilité →</a>
        <p class="rv" style="--d:.1s; margin-top:14px">
          <a href={`${WA}?text=${encodeURIComponent('Bonjour ! Pouvez-vous me faire un devis ? Mes dates : ')}`}
            target="_blank" rel="noopener" style="color:var(--lagoon); font-weight:700">
            ou demandez un devis sur WhatsApp
          </a>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .legend{ display:flex; flex-wrap:wrap; gap:10px 22px; margin:18px 0 8px; font-size:.8rem;
    color:var(--soft); }
  .legend b{ color:var(--lagoon); margin-right:5px; letter-spacing:.05em; }
  .legend.onDeep{ color:#a8d6db; }
  .legend.onDeep b{ color:var(--sun); }
  .bloc{ margin-top:34px; }
  .bloc h3{ font-family:var(--disp); font-size:1.15rem; margin:0 0 12px; }
  .bloc h3 em{ font-style:normal; font-size:.75rem; font-weight:600; opacity:.7; margin-left:10px; }
  .scoot-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(330px,1fr)); gap:8px 28px; }
  .facts{ display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px;
    margin-top:26px; }
  .fact{ background:#fff; border-radius:16px; padding:18px 20px; font-size:.88rem;
    color:var(--soft); box-shadow:0 6px 20px -12px rgba(10,70,80,.25); }
  .fact b{ display:block; font-family:var(--disp); color:var(--ink); margin-bottom:4px; }
</style>
