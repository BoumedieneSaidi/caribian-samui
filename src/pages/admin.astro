---
// Dashboard d'administration — 100 % côté client (Supabase Auth + RLS).
// Volontairement hors du layout public : interface utilitaire, mobile-first.
---
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Caribian Admin</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <style is:global>
    :root{
      --lagoon:#0b6e78; --lagoon-deep:#084c54; --turq:#12aebb; --coral:#ff6b57;
      --sun:#ffc33d; --palm:#2e9e6b; --sand:#fbf5ea; --ink:#10333b; --soft:#587a82;
      --line:#e5ddc9; --danger:#d2402c;
    }
    *{ box-sizing:border-box; }
    body{ margin:0; background:var(--sand); color:var(--ink);
      font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif; line-height:1.45;
      padding-bottom:76px; }
    button{ font:inherit; cursor:pointer; }
    input, select, textarea{ font:inherit; width:100%; padding:11px 13px; border:1.5px solid var(--line);
      border-radius:10px; background:#fff; color:var(--ink); }
    input:focus, select:focus, textarea:focus{ outline:2px solid var(--turq); border-color:var(--turq); }
    label{ display:block; font-size:.78rem; font-weight:700; color:var(--soft);
      text-transform:uppercase; letter-spacing:.07em; margin:12px 0 4px; }

    header.top{ position:sticky; top:0; z-index:20; background:var(--lagoon); color:#fff;
      padding:14px 18px; display:flex; justify-content:space-between; align-items:center; }
    header.top b{ font-size:1.02rem; }
    header.top button{ background:rgba(255,255,255,.15); color:#fff; border:none;
      border-radius:999px; padding:7px 14px; font-size:.8rem; font-weight:700; }

    main{ max-width:860px; margin:0 auto; padding:18px 16px 30px; }
    h2{ font-size:1.25rem; margin:6px 0 14px; }
    .muted{ color:var(--soft); font-size:.85rem; }

    /* Connexion */
    .login{ max-width:380px; margin:12vh auto 0; padding:0 20px; }
    .login .logo{ text-align:center; font-weight:800; font-size:1.3rem; margin-bottom:24px; }
    .login .logo span{ display:inline-block; width:22px; height:22px; border-radius:50%;
      vertical-align:-3px; margin-right:8px;
      background:radial-gradient(circle at 35% 35%, var(--sun), var(--coral)); }

    /* Onglets bas (mobile-first) */
    nav.tabs{ position:fixed; bottom:0; left:0; right:0; z-index:30; display:flex;
      background:#fff; border-top:1.5px solid var(--line);
      padding-bottom:env(safe-area-inset-bottom); }
    nav.tabs button{ flex:1; background:none; border:none; padding:9px 4px 10px; font-size:.68rem;
      font-weight:700; color:var(--soft); display:grid; gap:2px; justify-items:center; }
    nav.tabs button .i{ font-size:1.25rem; }
    nav.tabs button.cur{ color:var(--lagoon); }
    nav.tabs button .badge{ position:absolute; transform:translate(14px,-4px); background:var(--coral);
      color:#fff; font-size:.62rem; min-width:17px; height:17px; border-radius:999px;
      display:flex; align-items:center; justify-content:center; padding:0 4px; }

    /* Cartes génériques */
    .card{ background:#fff; border:1.5px solid var(--line); border-radius:14px;
      padding:14px 16px; margin-bottom:12px; }
    .row{ display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; }
    .btn{ border:none; border-radius:999px; padding:10px 18px; font-weight:800; font-size:.85rem; }
    .btn.p{ background:var(--palm); color:#fff; }
    .btn.d{ background:var(--danger); color:#fff; }
    .btn.n{ background:var(--ink); color:#fff; }
    .btn.g{ background:#eee7d4; color:var(--ink); }
    .btn.s{ background:var(--sun); color:#4a3305; }
    .btn:disabled{ opacity:.5; cursor:default; }
    .pill{ display:inline-block; font-size:.7rem; font-weight:800; border-radius:999px;
      padding:3px 10px; text-transform:uppercase; letter-spacing:.05em; }
    .pill.en_attente{ background:#fff3d6; color:#8a6100; }
    .pill.confirmee{ background:#ddf3e6; color:#166b41; }
    .pill.refusee, .pill.annulee{ background:#fde3de; color:#a02c1b; }
    .pill.terminee{ background:#e8e8e8; color:#555; }
    .dates{ font-variant-numeric:tabular-nums; font-weight:700; }
    .veh-thumb{ width:74px; height:54px; object-fit:cover; border-radius:8px; flex:none; }
    .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:0 14px; }
    .photolist{ display:flex; gap:10px; flex-wrap:wrap; margin-top:8px; }
    .photolist .ph{ position:relative; }
    .photolist img{ width:96px; height:70px; object-fit:cover; border-radius:8px; }
    .photolist button{ position:absolute; top:-7px; right:-7px; width:24px; height:24px;
      border-radius:50%; border:none; background:var(--danger); color:#fff; font-weight:800;
      line-height:1; }
    table.grille{ width:100%; border-collapse:collapse; background:#fff; font-size:.82rem; }
    table.grille th{ background:var(--lagoon); color:#fff; padding:8px 6px; font-size:.68rem;
      text-transform:uppercase; }
    table.grille td{ border:1px solid var(--line); padding:3px; }
    table.grille td:first-child{ padding:6px 8px; font-weight:700; white-space:nowrap; }
    table.grille input{ border:none; border-radius:0; padding:8px 4px; text-align:center;
      font-variant-numeric:tabular-nums; }
    .twrap{ overflow-x:auto; border-radius:10px; border:1.5px solid var(--line); }
    .toast{ position:fixed; left:50%; bottom:88px; transform:translateX(-50%); z-index:50;
      background:var(--ink); color:#fff; border-radius:999px; padding:11px 22px; font-size:.88rem;
      font-weight:600; box-shadow:0 10px 30px rgba(0,0,0,.3); opacity:0; transition:opacity .3s;
      pointer-events:none; max-width:90vw; text-align:center; }
    .toast.on{ opacity:1; }
    .toast.err{ background:var(--danger); }
    .empty{ text-align:center; color:var(--soft); padding:40px 10px; }
    .seg{ display:flex; gap:8px; margin-bottom:14px; overflow-x:auto; padding-bottom:2px; }
    .seg button{ border:1.5px solid var(--line); background:#fff; border-radius:999px;
      padding:7px 15px; font-size:.8rem; font-weight:700; color:var(--soft); white-space:nowrap; }
    .seg button.cur{ background:var(--lagoon); border-color:var(--lagoon); color:#fff; }
    .hidden{ display:none !important; }
    a.tel{ color:var(--lagoon); font-weight:700; text-decoration:none; }
    .note{ background:#fff9e8; border:1.5px solid #f0dfae; border-radius:10px; padding:10px 14px;
      font-size:.82rem; color:#6b5b23; margin-bottom:14px; }
    @media (min-width:720px){
      nav.tabs{ position:sticky; top:0; bottom:auto; border-top:none; border-bottom:1.5px solid var(--line); }
      body{ padding-bottom:20px; }
      header.top{ position:static; }
      .toast{ bottom:30px; }
    }
  </style>
</head>
<body>
  <div id="app"></div>
  <div class="toast" id="toast"></div>
  <script>
    import { mountAdmin } from '../admin/app';
    mountAdmin(document.getElementById('app')!);
  </script>
</body>
</html>
