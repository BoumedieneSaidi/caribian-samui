---
/** Carte véhicule (voiture) — contenu chargé depuis Supabase au build (voir lib/content.ts). */
import type { CarContent } from '../lib/content';

interface Props {
  car: CarContent;
  delay?: number;
  loading?: 'lazy' | 'eager';
}
const { car, delay = 0, loading = 'lazy' } = Astro.props;
---
<article class="car rv" style={`--d:${delay}s`}>
  <div class="im">
    {car.badge && <span class={`badge ${car.badgeColor}`}>{car.badge}</span>}
    <img
      src={car.image}
      alt={`${car.famille} ${car.nom} à louer chez Caribian Rental Samui`}
      width="900"
      height="600"
      loading={loading}
    />
  </div>
  <div class="bd">
    <h3>{car.nom}</h3>
    <div class="who">{car.famille} · {car.places} · clim</div>
    <div class="specs">
      <i>{car.transmission}</i>
      {car.extra && <i>{car.extra}</i>}
    </div>
    <div class="foot">
      <div class="px">
        <b>{car.prixJour.toLocaleString('fr-FR')} ฿</b>
        <small>par jour{car.prixJourEur ? ` · ${car.prixJourEur} €` : ''}</small>
      </div>
      <a class="rsv" href={`/reserver/?v=${car.slug}`}>Réserver</a>
    </div>
  </div>
</article>
